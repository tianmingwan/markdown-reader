{
  "name": "markdown-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "打开即预览的 Markdown 阅读器：Rust + Tauri 2，支持 Windows 桌面 + 安卓手机/平板（KaTeX / Mermaid / 语法高亮 / 多标签 / 全文搜索）",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node tests/mermaid.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/core/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "jsdom": "^30.0.1",
    "katex": "^0.16.22",
    "mermaid": "^11.12.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
